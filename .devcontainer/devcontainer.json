{
	"name": "Django",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"postCreateCommand": "pip install -r requirements.txt",
	"forwardPorts": [8000, 5432],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"batisteo.vscode-django"
			]
		}
	}
}
